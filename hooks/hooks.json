{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/overdrive-context.js\"; exit 0",
            "timeout": 5,
            "statusMessage": "Loading overdrive harness..."
          }
        ]
      }
    ]
  }
}
